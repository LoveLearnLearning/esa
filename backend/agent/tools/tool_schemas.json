  {
    "type": "function",
    "function": {
      "name": "record_learning_evidence",
      "description": "在真实且可评价的学习表现后写入一次学习证据。",
      "parameters": {
        "type": "object",
        "properties": {
          "kp_id": {
            "type": "string"
          },
          "activity_type": {
            "type": "string",
            "enum": [
              "practice",
              "homework",
              "retrieval",
              "hint",
              "teach_back",
              "transfer",
              "review"
            ]
          },
          "correct": {
            "type": "boolean",
            "description": "仅在可判定正误时填写。"
          },
          "self_confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "学生主观自信 0-1。"
          },
          "evidence_reliability": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "本次证据可靠性 0-1。"
          },
          "hint_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "attempts": {
            "type": "integer",
            "minimum": 1
          },
          "independent": {
            "type": "boolean"
          },
          "recall_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "explanation_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "transfer_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "error_type": {
            "type": "string",
            "enum": [
              "conceptual",
              "procedural",
              "strategic",
              "representation",
              "prerequisite",
              "careless",
              "unknown"
            ]
          },
          "misconception": {
            "type": "string"
          }
        },
        "required": [
          "kp_id",
          "activity_type"
        ]
      }
    }
  },
