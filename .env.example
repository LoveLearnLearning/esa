# ESA application models. Hub IDs work; set absolute paths for offline models.
ESA_DEBUG=false
ESA_LOG_PROMPTS=false
ESA_MODEL_PATH=Qwen/Qwen3.5-122B-A10B
ESA_MODEL_MAX_MODEL_LENGTH=131072
ESA_MODEL_MAX_OUTPUT_TOKENS=16384
ESA_MODEL_TENSOR_PARALLEL_SIZE=2
ESA_MODEL_PIPELINE_PARALLEL_SIZE=3
# Leave blank to disable LoRA. The adapter must match ESA_MODEL_PATH.
ESA_MODEL_LORA_PATH=
ESA_MODEL_LORA_NAME=esa-agent
ESA_MODEL_LORA_MAX_RANK=16
# Disable eager mode to enable torch.compile and LoRA-aware CUDA Graphs.
ESA_MODEL_ENFORCE_EAGER=false
# interactivity captures fine-grained small-batch graphs for chat latency.
ESA_MODEL_PERFORMANCE_MODE=interactivity
# Keep fully sharded opt-in; benchmark it for the selected adapter and TP size.
ESA_MODEL_LORA_FULLY_SHARDED=false
# With one resident adapter, specialize the LoRA kernel grid to one active LoRA.
ESA_MODEL_LORA_SPECIALIZE_ACTIVE=true
ESA_AUXILIARY_MODEL_PATH=Qwen/Qwen3.5-9B
ESA_AUXILIARY_MODEL_MAX_MODEL_LENGTH=65536
ESA_AUXILIARY_MODEL_MAX_OUTPUT_TOKENS=8192

# Isolated code execution. Dependency installation is restricted to this
# allowlist and only runs during the install phase; user code remains offline.
ESA_SANDBOX_ENABLED=false
ESA_SANDBOX_PACKAGE_INSTALL_ENABLED=false
ESA_SANDBOX_PYTHON_PACKAGE_ALLOWLIST=numpy,pandas,matplotlib,scipy,sympy,requests,pillow,opencv-python-headless,scikit-learn,seaborn

# You.com Search runs through a lifecycle-owned local MCP stdio bridge.
# Production sets this in the supercomputer job environment, not in source.
YDC_API_KEY=

# FastAPI / Nginx deployment.  Keep the /api prefix when proxying upstream.
HOST=0.0.0.0
PORT=51024
ESA_CORS_ALLOWED_ORIGINS=https://esa.lovelearnlearning.cn
ESA_TRUSTED_HOSTS=esa.lovelearnlearning.cn,localhost,127.0.0.1
ESA_FORWARDED_ALLOW_IPS=135.149.9.126
# Temporary aliases such as /auth/login remain available while old clients migrate.
ESA_ENABLE_LEGACY_API_ROUTES=true
ESA_WORKSPACE_ROUTER_SHADOW_ENABLED=true
ESA_WORKSPACE_RUNTIME_ENABLED=true
ESA_WORKSPACE_RUNTIME_LEARNING_ENABLED=true
ESA_WORKSPACE_RUNTIME_TEACHING_ENABLED=true
ESA_WORKSPACE_RUNTIME_RESEARCH_ENABLED=true
ESA_CORE_MEMORY_V2_ENABLED=true
ESA_RESEARCH_WORKFLOW_TOOLS_ENABLED=true

# Agent turn budgets. Workspace definitions use differentiated defaults.
ESA_AGENT_MAX_ITERATIONS=12
ESA_AGENT_MAX_TOOL_CALLS=24
ESA_AGENT_MAX_TOOL_RETRIES=1
ESA_AGENT_MAX_WALL_TIME_SECONDS=240
ESA_AGENT_TOOL_TIMEOUT_SECONDS=30
ESA_AGENT_STREAM_HEARTBEAT_SECONDS=15

# Chat attachments are stored without parsing until the model calls a parser
# tool. Keep the Nginx client_max_body_size at or above this value.
ESA_USER_ATTACHMENT_ROOT=backend/data/user
ESA_USER_ATTACHMENT_MAX_BYTES=209715200

# Personal knowledge base. Keep durable data and snapshots off /tmp; transient
# work defaults to $SLURM_TMPDIR/esa-personal-kb when available.
PERSONAL_KB_ENABLED=true
PERSONAL_KB_ROOT=/persist_data/home/chenxuzhao/esa-personal-knowledge-base
PERSONAL_KB_TEMP_ROOT=
PERSONAL_KB_SNAPSHOT_ROOT=/persist_data/home/chenxuzhao/esa-personal-knowledge-base/qdrant-snapshots
PERSONAL_KB_MAX_FILE_BYTES=209715200
PERSONAL_KB_MAX_BATCH_FILES=20
PERSONAL_KB_MAX_BATCH_BYTES=1073741824
PERSONAL_KB_MAX_REQUEST_BYTES=1090519040
PERSONAL_KB_MAX_USER_BYTES=10737418240
PERSONAL_KB_MAX_USER_FILES=1000
PERSONAL_KB_SNAPSHOT_MAX_DELAY_SECONDS=600
PERSONAL_KB_SNAPSHOT_RETENTION=3
PERSONAL_KB_RESTORE_ON_STARTUP=true
PERSONAL_KB_MINERU_API_URL=http://127.0.0.1:51026
PERSONAL_KB_MINERU_COMMAND=bin/run-mineru
PERSONAL_KB_MINERU_TIMEOUT_SECONDS=7200
PERSONAL_KB_MINERU_ATTEMPTS=2
# Optional Office-to-PDF preview converter. Leave blank to use bounded
# MinerU/DocIR text previews for Office files instead.
PERSONAL_KB_LIBREOFFICE_BIN=
PERSONAL_KB_OFFICE_PREVIEW_TIMEOUT_SECONDS=120
PERSONAL_KB_OFFICE_PREVIEW_MAX_BYTES=67108864
PERSONAL_KB_VISION_ENABLED=false
PERSONAL_KB_WORKERS=2
PERSONAL_KB_EMBEDDING_CONCURRENCY=1
PERSONAL_KB_JOB_TIMEOUT_SECONDS=3600
PERSONAL_KB_MAX_RETRIES=3
PERSONAL_KB_MAX_EXPANDED_BYTES=1073741824
PERSONAL_KB_MAX_PAGES=5000
PERSONAL_KB_MAX_IMAGES=10000
PERSONAL_KB_MAX_IMAGE_PIXELS=100000000
PERSONAL_KB_MIN_FREE_BYTES=1073741824
PERSONAL_KB_ORPHAN_RETENTION_SECONDS=86400
PERSONAL_KB_AUDIT_RETENTION_DAYS=90

# The supercomputer owns verification state and calls the separate mail server
# over HTTPS. Use different random values for TOKEN and VERIFICATION_SECRET.
ESA_EMAIL_PROVIDER=disabled
ESA_EMAIL_SERVICE_URL=https://mail-api.lovelearnlearning.cn
ESA_EMAIL_SERVICE_TOKEN=
ESA_EMAIL_VERIFICATION_SECRET=
ESA_EMAIL_CODE_TTL_SECONDS=600
ESA_EMAIL_CODE_COOLDOWN_SECONDS=60
ESA_EMAIL_CODE_MAX_ATTEMPTS=5
ESA_EMAIL_CODE_EMAIL_HOURLY_LIMIT=5
ESA_EMAIL_CODE_IP_HOURLY_LIMIT=20

# Unified public/personal Qdrant deployment. Use a fresh collection name for
# each rebuild/cutover; do not point this at an existing experimental collection.
RAG_ENABLED=false
# Versioned model-facing retrieval context. Keep off until model-context.v1
# fixtures/training/evaluation have been validated for the target Agent model.
RAG_METADATA_PROJECTION_MODE=off
RAG_COLLECTION_MANIFEST_PATH=artifacts/chunk/collections/collection_e55166f798ef1c361c72de9a/manifest.json
RAG_INDEX_DEPLOYMENT_MANIFEST_PATH=artifacts/rag/indexes/deployment_357bd9c84d8404fae42c2740/manifest.json
RAG_QDRANT_BASE_URL=http://127.0.0.1:6333
RAG_QDRANT_COLLECTION=esa_knowledge_unified_qwen3_4b
# Optional local filesystem override for the bundled Qdrant launcher; do not use NFS.
ESA_QDRANT_STORAGE_PATH=
# Immutable collection snapshot used to restore local storage in a new Slurm job.
ESA_QDRANT_SNAPSHOT_PATH=
QDRANT_API_KEY=
RAG_EMBEDDING_BACKEND=transformers
RAG_EMBEDDING_MODEL_PATH=Qwen/Qwen3-Embedding-4B
RAG_EMBEDDING_DEVICE=cuda
# Optional physical placement alias. It does not change the frozen index identity.
RAG_EMBEDDING_RUNTIME_DEVICE=
RAG_EMBEDDING_DIMENSION=2560
RAG_FUSION_METHOD=dense
RAG_DENSE_WEIGHT=1.0
# Disabled by default; enable explicitly only for controlled reranker experiments.
RAG_RERANKER_ENABLED=false
RAG_RERANKER_BACKEND=transformers
# Recall 100, diversity-preselect/rerank 50, and return at most five results.
RAG_DENSE_LIMIT=100
RAG_BM25_BODY_LIMIT=100
RAG_BM25_HEADING_LIMIT=100
RAG_RRF_LIMIT=100
RAG_RERANK_LIMIT=50
RAG_FINAL_LIMIT=5
RAG_MAX_CONTEXT_TOKENS=16384

# Use these only when the selected RAG backend is vllm.
RAG_EMBEDDING_BASE_URL=
RAG_RERANKER_BASE_URL=
RAG_RERANKER_MODEL_PATH=Qwen/Qwen3-Reranker-4B
RAG_RERANKER_DEVICE=cuda
# Optional physical placement alias; empty lets the launcher map it to the RAG GPU.
RAG_RERANKER_RUNTIME_DEVICE=
VLLM_API_KEY=

# Multimodal attachment sessions are opt-in.
MM_ENABLED=false
MM_ARTIFACT_ROOT=runtime/mm
MM_DIRECT_CONTEXT_TOKEN_LIMIT=80000
# The cluster launcher owns this loopback service and keeps MinerU models resident.
MM_MINERU_API_URL=http://127.0.0.1:51026
MM_MINERU_API_PORT=51026
MINERU_API_BIN=runtime/mineru-env/bin/mineru-api
# Device as seen inside the one-GPU MinerU sidecar.
MINERU_API_DEVICE_MODE=cuda:0
MINERU_API_OUTPUT_ROOT=
MINERU_API_TASK_RETENTION_SECONDS=300
# CLI fallback used when MM_MINERU_API_URL is empty.
MM_MINERU_COMMAND=bin/run-mineru
MINERU_BIN=mineru
# Optional colon-separated library path for headless OpenCV/MinerU runtimes.
MINERU_LIBRARY_PATH=
MINERU_TOOLS_CONFIG_JSON=runtime/mineru.json
HF_HOME=runtime/huggingface-mineru
MINERU_MODEL_SOURCE=huggingface
MINERU_DEVICE_MODE=cuda
MM_TOKENIZER_PATH=Qwen/Qwen3.5-122B-A10B
MM_VLM_BASE_URL=http://127.0.0.1:51025/v1
MM_VLM_MODEL=esa-qwen3.5-9b
MM_VLM_API_KEY=
MM_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
MM_EMBEDDING_DEVICE=cuda

# Optional cluster launcher integration.
ESA_CONDA_SH=
ESA_CONDA_ENV=
ESA_CUDA_HOME=
