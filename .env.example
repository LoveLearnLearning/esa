# ESA application models. Hub IDs work; set absolute paths for offline models.
ESA_DEBUG=false
ESA_MODEL_PATH=Qwen/Qwen3.5-122B-A10B
ESA_AUXILIARY_MODEL_PATH=Qwen/Qwen3.5-9B
SEARXNG_BASE_URL=http://127.0.0.1:8888

# FastAPI / Nginx deployment.  Keep the /api prefix when proxying upstream.
HOST=0.0.0.0
PORT=51024
ESA_CORS_ALLOWED_ORIGINS=https://esa.lovelearnlearning.cn
ESA_TRUSTED_HOSTS=esa.lovelearnlearning.cn,localhost,127.0.0.1
ESA_FORWARDED_ALLOW_IPS=135.149.9.126
# Temporary aliases such as /auth/login remain available while old clients migrate.
ESA_ENABLE_LEGACY_API_ROUTES=true
ESA_WORKSPACE_ROUTER_SHADOW_ENABLED=true
ESA_WORKSPACE_RUNTIME_ENABLED=true
ESA_WORKSPACE_RUNTIME_LEARNING_ENABLED=true
ESA_WORKSPACE_RUNTIME_TEACHING_ENABLED=true
ESA_WORKSPACE_RUNTIME_RESEARCH_ENABLED=true
ESA_CORE_MEMORY_V2_ENABLED=true
ESA_RESEARCH_WORKFLOW_TOOLS_ENABLED=true

# Chat attachments are stored without parsing until the model calls a parser
# tool. Keep the Nginx client_max_body_size at or above this value.
ESA_USER_ATTACHMENT_ROOT=backend/data/user
ESA_USER_ATTACHMENT_MAX_BYTES=209715200

# The supercomputer owns verification state and calls the separate mail server
# over HTTPS. Use different random values for TOKEN and VERIFICATION_SECRET.
ESA_EMAIL_PROVIDER=disabled
ESA_EMAIL_SERVICE_URL=https://mail-api.lovelearnlearning.cn
ESA_EMAIL_SERVICE_TOKEN=
ESA_EMAIL_VERIFICATION_SECRET=
ESA_EMAIL_CODE_TTL_SECONDS=600
ESA_EMAIL_CODE_COOLDOWN_SECONDS=60
ESA_EMAIL_CODE_MAX_ATTEMPTS=5
ESA_EMAIL_CODE_EMAIL_HOURLY_LIMIT=5
ESA_EMAIL_CODE_IP_HOURLY_LIMIT=20

# Frozen production RAG deployment (11 documents / 941 chunks).
RAG_ENABLED=false
RAG_COLLECTION_MANIFEST_PATH=artifacts/chunk/collections/collection_e55166f798ef1c361c72de9a/manifest.json
RAG_INDEX_DEPLOYMENT_MANIFEST_PATH=artifacts/rag/indexes/deployment_357bd9c84d8404fae42c2740/manifest.json
RAG_QDRANT_BASE_URL=http://127.0.0.1:6333
RAG_QDRANT_COLLECTION=rag_qwen3_embedding_4b_v2
# Optional local filesystem override for the bundled Qdrant launcher; do not use NFS.
ESA_QDRANT_STORAGE_PATH=
# Immutable collection snapshot used to restore local storage in a new Slurm job.
ESA_QDRANT_SNAPSHOT_PATH=
QDRANT_API_KEY=
RAG_EMBEDDING_BACKEND=transformers
RAG_EMBEDDING_MODEL_PATH=Qwen/Qwen3-Embedding-4B
RAG_EMBEDDING_DEVICE=cuda
# Optional physical placement alias. It does not change the frozen index identity.
RAG_EMBEDDING_RUNTIME_DEVICE=
RAG_EMBEDDING_DIMENSION=2560
RAG_FUSION_METHOD=dense
RAG_DENSE_WEIGHT=1.0
RAG_RERANKER_ENABLED=false
RAG_RERANKER_BACKEND=none
RAG_RERANK_LIMIT=20
RAG_FINAL_LIMIT=5
RAG_MAX_CONTEXT_TOKENS=8192

# Use these only when the selected RAG backend is vllm.
RAG_EMBEDDING_BASE_URL=
RAG_RERANKER_BASE_URL=
RAG_RERANKER_MODEL_PATH=Qwen/Qwen3-Reranker-4B
VLLM_API_KEY=

# Multimodal attachment sessions are opt-in.
MM_ENABLED=false
MM_ARTIFACT_ROOT=runtime/mm
# The cluster launcher owns this loopback service and keeps MinerU models resident.
MM_MINERU_API_URL=http://127.0.0.1:51026
MM_MINERU_API_PORT=51026
MINERU_API_BIN=runtime/mineru-env/bin/mineru-api
# Device as seen inside the one-GPU MinerU sidecar.
MINERU_API_DEVICE_MODE=cuda:0
MINERU_API_OUTPUT_ROOT=
MINERU_API_TASK_RETENTION_SECONDS=300
# CLI fallback used when MM_MINERU_API_URL is empty.
MM_MINERU_COMMAND=bin/run-mineru
MINERU_BIN=mineru
# Optional colon-separated library path for headless OpenCV/MinerU runtimes.
MINERU_LIBRARY_PATH=
MINERU_TOOLS_CONFIG_JSON=runtime/mineru.json
HF_HOME=runtime/huggingface-mineru
MINERU_MODEL_SOURCE=huggingface
MINERU_DEVICE_MODE=cuda
MM_TOKENIZER_PATH=Qwen/Qwen3.5-122B-A10B
MM_VLM_BASE_URL=http://127.0.0.1:51025/v1
MM_VLM_MODEL=esa-qwen3.5-9b
MM_VLM_API_KEY=
MM_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
MM_EMBEDDING_DEVICE=cuda

# Optional cluster launcher integration.
ESA_CONDA_SH=
ESA_CONDA_ENV=
ESA_CUDA_HOME=
