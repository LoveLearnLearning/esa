              "title",
              "author",
              "abstract",
              "category"
            ],
            "default": "all"
          },
          "max_results": {
            "type": "integer",
            "default": 5
          },
          "sort_by": {
            "type": "string",
            "enum": [
              "relevance",
              "lastUpdated",
              "submitted"
            ],
            "default": "relevance"
          },
          "sort_order": {
            "type": "string",
            "enum": [
              "ascending",
              "descending"
            ],
            "default": "descending"
          }
        },
        "required": [
          "query"
        ]
      }
    }
  },
