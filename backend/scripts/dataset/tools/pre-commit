#!/bin/sh
# 数据校验 pre-commit hook。
#
# 安装：
#   ln -sf ../../dataset/tools/pre-commit .git/hooks/pre-commit
#
# 目的：坏样本不能进仓。LLaMA-Factory 遇到坏样本只打一行 warning 就静默跳过，
# 训练量悄悄缩水而没人察觉——所以必须在入库这一步拦下来。

set -e

if ! git diff --cached --name-only | grep -q '^dataset/'; then
    exit 0
fi

if ! ls dataset/data/ir/*.jsonl >/dev/null 2>&1; then
    exit 0
fi

echo "==> 校验数据集…"
PYTHONPATH=dataset python3 -m esa.validate dataset/data/ir/*.jsonl || {
    echo
    echo "校验未通过，提交已中止。修好上面的问题，或用 git commit --no-verify 跳过（不建议）。"
    exit 1
}

echo "==> 自检…"
python3 dataset/tests/test_validator.py >/dev/null || { echo "校验器自检失败"; exit 1; }
